<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        数据安全域编排 —— 数据安全域编排层：安全策略（识别→脱敏→水印→审计四段流水线）+ 对外防护入口

        工程形状照抄 z-biz / z-etl（core+web 两段式 + 自管根 pom）：
          parent = io.github.yuku123:z-boot-parent:1.2.0（Java 17 / Spring Boot 3 火车口径）
          版本   = CI-friendly ${revision} + flatten-maven-plugin(oss)
          发版   = **不发 Maven Central**（groupId com.zifang = L1 内部件口径，同 z-biz）⇒ maven.deploy.skip 置 true
    -->
    <parent>
        <groupId>io.github.yuku123</groupId>
        <artifactId>z-boot-parent</artifactId>
        <version>1.2.1</version>
        <relativePath/>
    </parent>

    <groupId>com.zifang</groupId>
    <artifactId>z-security</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>

    <name>数据安全域编排 :: root</name>
    <description>数据安全域编排层：安全策略（识别→脱敏→水印→审计四段流水线）+ 对外防护入口</description>

    <url>https://github.com/z-opc-foundation/z-security</url>
    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>yuku123</id>
            <name>yuku123</name>
            <email>1340947819@qq.com</email>
            <organization>z-opc-foundation</organization>
            <organizationUrl>https://github.com/z-opc-foundation</organizationUrl>
            <timezone>+08:00</timezone>
            <roles>
                <role>owner</role>
            </roles>
        </developer>
    </developers>
    <scm>
        <connection>scm:git:https://github.com/z-opc-foundation/z-security.git</connection>
        <developerConnection>scm:git:git@github.com:z-opc-foundation/z-security.git</developerConnection>
        <url>https://github.com/z-opc-foundation/z-security</url>
        <tag>HEAD</tag>
    </scm>

    <modules>
        <module>z-security-core</module>
        <module>z-security-starter</module>
        <module>z-security-web</module>
    </modules>

    <properties>
        <!-- 项目自身版本（CI-friendly 根，发版改这一处）。首版号 = 1.0.0。 -->
        <revision>1.0.0</revision>

        <!-- 版本口径全部由 parent(z-boot-parent:1.2.0) 下发：maven.compiler.source/target=17、
             UTF-8、spring-boot 3.3.13、mybatis-plus、flatten-maven-plugin 1.7.3。这里只留父链不供的键。 -->
        <compile.version>17</compile.version>

        <!-- 父链不供、此处自备的插件版本（z-biz 同款取法）。 -->
        <versions-maven-plugin.version>2.17.1</versions-maven-plugin.version>

        <!-- 本地夹具库版本（H2 跑 DDL 幂等与接口可路由，不连任何真实库）。 -->
        <h2.version>2.2.224</h2.version>

        <!-- 安全线族内坐标（四段流水线的各 core）。 -->
        <z-sense.version>1.0.0</z-sense.version>
        <z-mask.version>1.0.0</z-mask.version>
        <z-watermark.version>1.0.0</z-watermark.version>
        <z-audit.version>1.0.0</z-audit.version>

        <!-- ⚠️ **不发 Maven Central**（groupId com.zifang = L1 内部件口径，同 z-biz）⇒ maven.deploy.skip 置 true -->
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- 自家 reactor 坐标钉本仓版本（写 ${revision}）。 -->
            <dependency>
                <groupId>com.zifang</groupId>
                <artifactId>z-security</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.zifang</groupId>
                <artifactId>z-security-core</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.zifang</groupId>
                <artifactId>z-security-starter</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.zifang</groupId>
                <artifactId>z-security-web</artifactId>
                <version>${revision}</version>
            </dependency>
            <!-- 族内依赖钉版本（就近 DM，z-boot-parent 接入面 pin 未收录新族坐标）。 -->
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-sense-core</artifactId>
                <version>${z-sense.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-mask-core</artifactId>
                <version>${z-mask.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-watermark-core</artifactId>
                <version>${z-watermark.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-audit-core</artifactId>
                <version>${z-audit.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- 全仓统一测试台（与 z-biz 同款；版本由 parent 的 junit-bom 下发）。 -->
    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.vintage</groupId>
            <artifactId>junit-vintage-engine</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven-compiler-plugin.version}</version>
                <configuration>
                    <source>${compile.version}</source>
                    <target>${compile.version}</target>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>versions-maven-plugin</artifactId>
                <version>${versions-maven-plugin.version}</version>
                <configuration>
                    <generateBackupPoms>false</generateBackupPoms>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>${flatten-maven-plugin.version}</version>
                <configuration>
                    <updatePomFile>true</updatePomFile>
                    <!-- oss 模式：保留 Central 元数据(url/licenses/developers/scm)、剥掉
                         <parent>/<dependencyManagement>/<build>，并把 ${revision} 与继承来的
                         依赖版本写死（与 z-biz / z-etl 同款）。 -->
                    <flattenMode>oss</flattenMode>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals><goal>flatten</goal></goals>
                    </execution>
                    <execution>
                        <id>flatten.clean</id>
                        <phase>clean</phase>
                        <goals><goal>clean</goal></goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
