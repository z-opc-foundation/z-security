<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.zifang</groupId>
        <artifactId>z-security</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>z-security-starter</artifactId>
    <name>数据安全域编排 :: starter</name>
    <packaging>jar</packaging>

    <description>数据安全域编排层：安全策略（识别→脱敏→水印→审计四段流水线）+ 对外防护入口（starter：编排引擎装配 + 本域数据源，可嵌入宿主，无 web 面）</description>

    <dependencies>
        <dependency>
            <groupId>com.zifang</groupId>
            <artifactId>z-security-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 编排层直接依赖四个能力仓的 core（不是它们的 starter）：
             本域数据源的 @MapperScan 要把 z-audit Mapper 绑到本域 sqlSessionFactory 上
             （同库同表单写者口径），依赖 z-audit-starter 会引发双 @MapperScan 冲突。 -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-sense-core</artifactId>
            <version>${z-sense.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-mask-core</artifactId>
            <version>${z-mask.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-watermark-core</artifactId>
            <version>${z-watermark.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-audit-core</artifactId>
            <version>${z-audit.version}</version>
        </dependency>
        <!-- ModuleDataSourceTemplate 所在：z.base.db.* 键名模式的权威实现（本域数据源装配用）。 -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-boot-datasource-starter</artifactId>
        </dependency>
        <!-- MybatisSqlSessionFactoryBean（本域 sqlSessionFactory 装配用）。 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-extension</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 本地夹具库：嵌入装配验收在 H2 上跑，不连任何真实库。 -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>${h2.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
